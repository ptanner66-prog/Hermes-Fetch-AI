# hermes-fetch-ai does not read .env files. Set these in the environment of the
# process that runs the bridge: your shell, a systemd EnvironmentFile, or
# $HERMES_HOME/.env when running through `hermes fetchai-bridge`.
# Never commit real values.

# The bridge's stable identity (at least 32 random characters). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
UAGENT_SEED=
