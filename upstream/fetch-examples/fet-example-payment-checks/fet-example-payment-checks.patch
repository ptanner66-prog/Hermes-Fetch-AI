+++ b/fet-example/verify.py
@@ -0,0 +1,52 @@
+"""Checks for a FET payment, read from the ledger rather than taken from the buyer.
+
+A buyer's CommitPayment says what it paid. Before delivering, check the
+transaction itself: it succeeded, its bank sends move at least the seller's own
+price, in the right denomination, from the buyer's wallet to the seller's, and
+it has not paid for an earlier request (see handle_commit_payment).
+"""
+
+from decimal import Decimal, InvalidOperation
+
+FET_DECIMALS = 18  # 1 FET = 10**18 afet (atestfet on the testnet)
+MSG_SEND = "/cosmos.bank.v1beta1.MsgSend"
+
+
+def fet_to_base(amount: str) -> int:
+    """An amount in FET, such as "0.1", in afet, exactly. float("1.1") * 10**18 is off by 128."""
+    try:
+        value = Decimal(str(amount))
+    except InvalidOperation:
+        raise ValueError(f"not an amount: {amount!r}") from None
+    if not value.is_finite() or value <= 0:
+        raise ValueError(f"not a FET amount: {amount!r}")
+    base = value.scaleb(FET_DECIMALS)
+    if base != base.to_integral_value():
+        raise ValueError(f"more than {FET_DECIMALS} decimals: {amount!r}")
+    return int(base)
+
+
+def normalize_tx_hash(transaction_id: str) -> str:
+    """A transaction hash as the ledger writes it: 64 hex digits, upper case."""
+    tx_hash = transaction_id.strip().upper().removeprefix("0X")
+    if len(tx_hash) != 64 or any(c not in "0123456789ABCDEF" for c in tx_hash):
+        raise ValueError(f"not a transaction hash: {transaction_id!r}")
+    return tx_hash
+
+
+def paid_to(tx, recipient: str, sender: str, denom: str) -> int:
+    """How much of `denom` the transaction's bank sends move from `sender` to `recipient`.
+
+    `tx` is the transaction itself (GetTxResponse.tx), not query_tx()'s summary,
+    which merges the events of each type and so shows only one of several transfers.
+    """
+    from cosmpy.protos.cosmos.bank.v1beta1.tx_pb2 import MsgSend
+
+    total = 0
+    for message in tx.body.messages:
+        if message.type_url != MSG_SEND:
+            continue
+        send = MsgSend.FromString(message.value)
+        if send.from_address == sender and send.to_address == recipient:
+            total += sum(int(coin.amount) for coin in send.amount if coin.denom == denom)
+    return total
